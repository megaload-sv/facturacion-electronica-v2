# The subdomain DocumentRoot must point to public/, never the project root.
# Fail closed if a hosting configuration accidentally exposes this directory.
Require all denied

 RewriteEngine On
 RewriteRule ^(.*)$ /public/$1 [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Configure el paquete “ea-php83” como el lenguaje de programación predeterminado “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
